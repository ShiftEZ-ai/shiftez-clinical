{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUnusedLocals": false, "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true, "outDir": "dist/assets", "rootDir": "src",
    "sourceMap": false, "skipLibCheck": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
