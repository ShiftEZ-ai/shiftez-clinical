 ],
 "regex": [
  {
   "allow_paths": [],
   "case": "insensitive",
   "class": "tailnet",
   "id": "P01",
   "pattern": "\\.ts\\.net\\b"
  },
  {
   "allow_paths": [
    "tests/test_score_check_provider.py",
    "tests/test_signin_oidc_security.py"
   ],
   "case": "insensitive",
   "class": "tailnet",
   "id": "P02",
   "pattern": "\\b100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\.\\d{1,3}\\.\\d{1,3}\\b"
  },
  {
   "allow_paths": [],
   "case": "insensitive",
   "class": "private-key",
   "id": "P03",
   "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
  },
  {
   "allow_paths": [],
   "case": "insensitive",
   "class": "wording",
   "id": "P04",
   "pattern": "open[\\s-]?source"
  },
  {
   "allow_paths": [],
   "case": "insensitive",
   "class": "provenance",
   "id": "P06",
   "pattern": "\\b(?:commit|sha|fixed in|since|rev)\\b[\\s:=#'\\\"(]{0,3}[0-9a-f]{7,40}\\b"
  },
  {
   "allow_paths": [
    "packages/contracts/schemas.py",
    "packages/contracts/public-schemas.json",
    "apps/web/src/generated.ts"
   ],
   "case": "insensitive",
   "class": "product-name",
   "id": "P05",
   "pattern": "ShiftEZ\\s+Clinical"
  }
 ],
 "version": 3
}
