{
  "id": "A-OVERTIME-CAP-01",
  "revision": 1,
  "title": "Overtime duty cap on a personal offer",
  "intent": "Only matching overtime duties use the approved offer cap.",
  "pressure": "A fixed regular duty is in scope. Switching it to overtime would exceed the approved cap.",
  "covers": {
    "kind.block_quota.overtime": [
      "validator",
      "counterfactual",
      "seed_robustness"
    ]
  },
  "commands": [
    {"key": "rank", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "categories", "value": {"name": "A-OVERTIME-CAP-01 staff rank", "starts_on": "2027-01-01"}, "reason": "Synthetic scenario"}},
    {"key": "service", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "services", "value": {"name": "A-OVERTIME-CAP-01 primary clinic", "starts_on": "2027-01-01"}, "reason": "Synthetic scenario"}},
    {"key": "room_type", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "location_types", "value": {"name": "A-OVERTIME-CAP-01 room type", "starts_on": "2027-01-01"}, "reason": "Synthetic scenario"}},
    {"key": "room", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "locations", "value": {"name": "A-OVERTIME-CAP-01 primary room", "starts_on": "2027-01-01", "location_type_id": "$room_type", "capacity": 10}, "reason": "Synthetic scenario"}},
    {"key": "p0", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "people", "value": {"display_name": "سنبلة الجبلي", "tags": ["golden"]}, "reason": "Synthetic scenario"}},
    {"key": "p0_rank", "role": "admin", "kind": "membership.create",
     "payload": {"person_id": "$p0", "category_id": "$rank", "starts_on": "2027-01-01"}},
    {"key": "p0_service", "role": "credentialer", "kind": "eligibility.create",
     "payload": {"person_id": "$p0", "service_id": "$service", "starts_on": "2027-01-01"}},
    {"key": "offer", "role": "coordinator", "kind": "person.overtime.propose",
     "payload": {"kind": "overtime_offer", "person_id": "$p0", "catalogue_id": "overtime_offers", "overtime_duty_cap": 1, "line": {"id": "91b96a12-19b3-4f46-9aa3-c965cb9304ca", "starts_on": "2027-01-04", "ends_on": "2027-01-06", "numbers": {"apply": {"value": null, "level": "medium"}}, "settings": {"allocation_overtime": {"volunteer_required": false}}}, "reason": "Synthetic overtime offer cap"}},
    {"key": "approved", "role": "approver", "kind": "person.overtime.activate", "target": "$offer", "revision": "$offer.revision",
     "payload": {"reason": "Independent synthetic approval"}},
    {"key": "workspace", "role": "coordinator", "kind": "workspace.create",
     "payload": {"name": "A-OVERTIME-CAP-01", "starts_on": "2027-01-01", "ends_on": "2027-01-12"}},
    {"key": "first_type", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "assignment_types", "value": {"name": "A-OVERTIME-CAP-01 first_type duty", "starts_on": "2027-01-01", "definition": {"requirements": [{"minimum": 1, "maximum": 1}]}}, "reason": "Synthetic scenario"}},
    {"key": "first", "role": "coordinator", "kind": "shift.create", "revision": "$workspace.revision",
     "payload": {"workspace_id": "$workspace", "assignment_type_id": "$first_type", "location_id": "$room", "service_ids": ["$service"], "start": "2027-01-04T08:00:00+03:00", "end": "2027-01-04T12:00:00+03:00", "participants": [{"start": "2027-01-04T08:00:00+03:00", "end": "2027-01-04T12:00:00+03:00", "person_id": "$p0", "overtime": true, "fixed": true}]}},
    {"key": "next", "role": "coordinator", "kind": "shift.create", "revision": "$workspace.revision",
     "payload": {"workspace_id": "$workspace", "assignment_type_id": "$first_type", "location_id": "$room", "service_ids": ["$service"], "start": "2027-01-05T08:00:00+03:00", "end": "2027-01-05T12:00:00+03:00", "participants": [{"person_id": "$p0", "start": "2027-01-05T08:00:00+03:00", "end": "2027-01-05T12:00:00+03:00", "fixed": true}]}}
  ],
  "inputs": {
    "generation_options": {
      "mode": "fill_gaps"
    }
  },
  "expect": {
    "binding_rules": [
      "offer"
    ],
    "validator": "QUOTA_ABOVE_MAXIMUM",
    "counterfactual": "requirements_conflict",
    "seed_robustness": {
      "seeds": [
        11,
        29,
        47
      ],
      "workers": 1
    }
  }
}
