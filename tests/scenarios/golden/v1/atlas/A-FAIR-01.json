{
  "id": "A-FAIR-01",
  "revision": 3,
  "title": "Pooled Fair share across a rolling month",
  "intent": "A month ending on 31 March begins on the last day of February.",
  "pressure": "Pooling two independently scoped duty types makes moving one editable duty improve equal share.",
  "covers": {
    "kind.balance_goal.comparison": [
      "pooled",
      "within_group",
      "solver_choice"
    ],
    "kind.balance_goal.period_months": [
      "pooled",
      "day_window"
    ]
  },
  "commands": [
    {"key": "rank", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "categories", "value": {"name": "A-FAIR-01 staff rank", "starts_on": "2027-01-01"}, "reason": "Synthetic scenario"}},
    {"key": "service", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "services", "value": {"name": "A-FAIR-01 clinic", "starts_on": "2027-01-01"}, "reason": "Synthetic scenario"}},
    {"key": "room_type", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "location_types", "value": {"name": "A-FAIR-01 room type", "starts_on": "2027-01-01"}, "reason": "Synthetic scenario"}},
    {"key": "room", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "locations", "value": {"name": "A-FAIR-01 room", "starts_on": "2027-01-01", "location_type_id": "$room_type", "capacity": 8}, "reason": "Synthetic scenario"}},
    {"key": "p0", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "people", "value": {"display_name": "staff member 01"}, "reason": "Synthetic scenario"}},
    {"key": "p0_rank", "role": "admin", "kind": "membership.create",
     "payload": {"person_id": "$p0", "category_id": "$rank", "starts_on": "2027-01-01"}},
    {"key": "p0_service", "role": "credentialer", "kind": "eligibility.create",
     "payload": {"person_id": "$p0", "service_id": "$service", "starts_on": "2027-01-01"}},
    {"key": "p1", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "people", "value": {"display_name": "staff member 02"}, "reason": "Synthetic scenario"}},
    {"key": "p1_rank", "role": "admin", "kind": "membership.create",
     "payload": {"person_id": "$p1", "category_id": "$rank", "starts_on": "2027-01-01"}},
    {"key": "p1_service", "role": "credentialer", "kind": "eligibility.create",
     "payload": {"person_id": "$p1", "service_id": "$service", "starts_on": "2027-01-01"}},
    {"key": "workspace", "role": "coordinator", "kind": "workspace.create",
     "payload": {"name": "A-FAIR-01", "starts_on": "2027-02-25", "ends_on": "2027-03-31"}},
    {"key": "first_type", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "assignment_types", "value": {"name": "A-FAIR-01 first duty type", "starts_on": "2027-01-01", "definition": {"requirements": [{"minimum": 1, "maximum": 1}]}}, "reason": "Synthetic scenario"}},
    {"key": "second_type", "role": "admin", "kind": "catalogue.create",
     "payload": {"catalogue": "assignment_types", "value": {"name": "A-FAIR-01 second duty type", "starts_on": "2027-01-01", "definition": {"requirements": [{"minimum": 1, "maximum": 1}]}}, "reason": "Synthetic scenario"}},
    {"key": "share", "role": "coordinator", "kind": "rule.propose",
     "payload": {
       "catalogue_id": "fair_share", "catalogue_version": 1,
       "reason": "Synthetic Fair share comparison",
       "lines": [
         {
           "id": "00000000-0000-4000-8000-000000000001",
           "where": {"conditions": [{"field": "assignment_type_ids", "op": "any", "values": ["$first_type"]}]},
           "who": {"conditions": [{"field": "person_ids", "values": ["$p0", "$p1"]}]},
           "numbers": {"apply": {"value": null, "level": "medium"}},
           "settings": {"balance_goal": {
             "metric": "duties", "comparison": "pooled", "period": "rolling", "period_months": 1,
             "share_by": "equal", "tolerance_percent": 0, "tolerance_units": 0
           }}
         },
         {
           "id": "00000000-0000-4000-8000-000000000002",
           "where": {"conditions": [{"field": "assignment_type_ids", "op": "any", "values": ["$second_type"]}]},
           "who": {"conditions": [{"field": "person_ids", "values": ["$p0", "$p1"]}]},
           "numbers": {"apply": {"value": null, "level": "medium"}},
           "settings": {"balance_goal": {
             "metric": "duties", "comparison": "pooled", "period": "rolling", "period_months": 1,
             "share_by": "equal", "tolerance_percent": 0, "tolerance_units": 0
           }}
         }
       ]}},
    {"key": "share_active", "role": "approver", "kind": "policy.activate", "target": "$share", "revision": "$share.revision",
     "payload": {"reason": "Independent synthetic approval"}},
    {"key": "before", "role": "coordinator", "kind": "shift.create", "revision": "$workspace.revision",
     "payload": {"workspace_id": "$workspace", "assignment_type_id": "$first_type", "location_id": "$room", "service_ids": ["$service"], "start": "2027-02-27T08:00:00+03:00", "end": "2027-02-27T12:00:00+03:00", "participants": [{"start": "2027-02-27T08:00:00+03:00", "end": "2027-02-27T12:00:00+03:00", "person_id": "$p1", "fixed": true}]}},
    {"key": "boundary", "role": "coordinator", "kind": "shift.create", "revision": "$workspace.revision",
     "payload": {"workspace_id": "$workspace", "assignment_type_id": "$first_type", "location_id": "$room", "service_ids": ["$service"], "start": "2027-02-28T08:00:00+03:00", "end": "2027-02-28T12:00:00+03:00", "participants": [{"start": "2027-02-28T08:00:00+03:00", "end": "2027-02-28T12:00:00+03:00", "person_id": "$p0", "fixed": true}]}},
    {"key": "fixed_first", "role": "coordinator", "kind": "shift.create", "revision": "$workspace.revision",
     "payload": {"workspace_id": "$workspace", "assignment_type_id": "$first_type", "location_id": "$room", "service_ids": ["$service"], "start": "2027-03-01T08:00:00+03:00", "end": "2027-03-01T12:00:00+03:00", "participants": [{"start": "2027-03-01T08:00:00+03:00", "end": "2027-03-01T12:00:00+03:00", "person_id": "$p0", "fixed": true}]}},
    {"key": "choice", "role": "coordinator", "kind": "shift.create", "revision": "$workspace.revision",
     "payload": {"workspace_id": "$workspace", "assignment_type_id": "$second_type", "location_id": "$room", "service_ids": ["$service"], "start": "2027-03-02T08:00:00+03:00", "end": "2027-03-02T12:00:00+03:00", "participants": [{"start": "2027-03-02T08:00:00+03:00", "end": "2027-03-02T12:00:00+03:00", "person_id": "$p0"}]}}
  ],
  "expect": {
